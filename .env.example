########################################################################
# rag-stack configuration
#
# Copy this file to .env and fill in the MODEL_* values. Everything
# else has a sane default for a single-machine deployment. Run
# `./ragctl install` after editing this file.
########################################################################

# ---- Models (you provide these; pull them with `ollama pull <name>`) ----
# Run `./ragctl models check` after `ollama pull` to confirm names match.

# Where the two chat models run. ollama = locally, like everything else.
# openrouter = OpenRouter's hosted models, for developing on a machine too
# small for the real ones: set the CHAT_MODEL_* values below to OpenRouter
# model ids (e.g. anthropic/claude-sonnet-5, see https://openrouter.ai/models)
# and OPENROUTER_API_KEY. Requests use floor routing (":floor", the cheapest
# provider for the model, flex tiers included); a model id that already has a
# suffix such as ":free" or ":nitro" is sent as written. Only chat moves:
# embeddings, the VLM fallback and the reranker stay local. The retrieved
# passages of every question are sent to OpenRouter and the model's provider,
# so only use documents you can share.
CHAT_PROVIDER=ollama
OPENROUTER_API_KEY=
# Only change this to route through an OpenRouter-compatible proxy.
OPENROUTER_URL=https://openrouter.ai/api/v1

# Everyday chat model — fast, used for most questions.
CHAT_MODEL_EVERYDAY=

# Hard-questions chat model — larger, used when the user picks it explicitly.
CHAT_MODEL_HARD=

# Embedding model, served by Ollama (e.g. bge-m3, qwen3-embedding).
EMBED_MODEL=

# Vision-language model used ONLY as an OCR fallback for pages that
# come out garbled from OCR + Docling (e.g. a Qwen-VL model).
VLM_MODEL=

# ---- Networking ----
# Bind address for the query service (UI + API) and the services Docker
# publishes (Qdrant, Open WebUI). Keep 127.0.0.1 for a single-user laptop.
# Set to 0.0.0.0 to serve other machines on the network; apply with
# `./ragctl up`. That sends passwords over plain http and exposes Qdrant,
# which has no auth -- fine for a test on a trusted LAN, otherwise put TLS
# in front of the query service.
BIND_ADDR=127.0.0.1
QDRANT_PORT=6333
DOCLING_PORT=5001
OLLAMA_PORT=11434

# ---- Embedding / indexing (services/embed) ----
QDRANT_COLLECTION=ragstack_chunks
# HuggingFace tokenizer matching EMBED_MODEL, used to size chunks. Must be the
# same model family: bge-m3 in Ollama -> BAAI/bge-m3 here.
EMBED_TOKENIZER=BAAI/bge-m3
# Max tokens per chunk, heading path included.
CHUNK_MAX_TOKENS=512
# Merge small sibling sections under one parent heading (e.g. a list of short
# subsections) into shared chunks, up to CHUNK_MAX_TOKENS.
CHUNK_MERGE_SIBLINGS=true
# Chunks per /api/embed request. Batches are sent one at a time, so this
# never adds to Ollama's request queue.
EMBED_BATCH_SIZE=32

# ---- Retrieval (services/query) ----
# hybrid = dense + BM25 fused; dense or bm25 = one retriever alone (useful
# for comparing what each contributes).
RAG_SEARCH_MODE=hybrid
# Candidates each retriever (dense, BM25) contributes before fusion.
RAG_PREFETCH_K=40
# Results returned after fusion -- what the reranker will re-score.
RAG_TOP_K=20
# rrf = reciprocal rank fusion (uses ranks only; robust default).
# dbsf = distribution-based score fusion (normalizes and sums the scores).
RAG_FUSION=rrf
# RRF only: score = sum of weight / (RAG_RRF_K + rank). Larger k flattens
# the gap between top and lower ranks; 60 is the usual choice.
RAG_RRF_K=60
# RRF only: relative trust in each retriever. Raise BM25 for exact terms
# (acronyms, clause numbers), dense for paraphrased questions.
RAG_DENSE_WEIGHT=1.0
RAG_BM25_WEIGHT=1.0
# ---- Reranking (services/query/rerank.py) ----
# A cross-encoder re-scores the RAG_TOP_K fused candidates against the
# question and keeps those scoring at least RAG_RERANK_MIN_SCORE, best first.
# false = keep the top fused results instead (for comparison).
RAG_RERANK=true
# Relevance threshold (0..1). Measured: off-topic questions and the tails of
# real ones score <= 0.08, useful passages >= 0.1 (even for vague questions).
# Below it, a question gets no passages rather than weak ones.
RAG_RERANK_MIN_SCORE=0.1
# Safety cap on results per search (a whole section counts as one). The chat
# selects by token budget instead (CHAT_AUTO_SOURCE_TOKENS).
RAG_TOP_K_RERANKER=10
# When two or more matching chunks share a heading, return the whole section
# under the deepest such heading as one result, if it fits in this many
# (approximate) tokens. Keeps list-like sections together.
RAG_EXPAND_SECTIONS=true
RAG_SECTION_MAX_TOKENS=2000
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto = Apple GPU (MPS) when available, else CUDA, else CPU. Measured on
# this stack: MPS ~1.2 s for 20 chunks vs ~2.8 s on CPU.
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=16
# Token limit per question+chunk pair; chunks are <= CHUNK_MAX_TOKENS, so
# this only needs headroom above that plus the question.
RERANKER_MAX_LENGTH=1024

# ---- Query service: chat API (services/query/api.py) ----
# http://127.0.0.1:QUERY_PORT/api (native) and /v1 (OpenAI-compatible).
# Always bound to 127.0.0.1 until user accounts exist.
QUERY_PORT=8088
# A shared service account for scripts: "Authorization: Bearer <key>" acts as
# it. To act as a particular person instead, use a personal token
# (ragctl user token add, or POST /api/tokens) -- this key isn't needed for that.
QUERY_API_KEY=
# Presets: CHAT_MODEL_EVERYDAY / CHAT_MODEL_HARD above, plus per preset:
# TOOLS lets the model run extra searches (search_documents) after the
# automatic one; THINK turns on the model's reasoning. Measured with
# qwen3.5:9b, the model only uses the search tool reliably with thinking on
# (4/4 runs vs 1/12 without), at the cost of ~5-10 s before it answers.
CHAT_DEFAULT_PRESET=everyday
CHAT_TOOLS_EVERYDAY=true
CHAT_THINK_EVERYDAY=false
CHAT_TOOLS_HARD=true
CHAT_THINK_HARD=true
CHAT_TEMPERATURE=0.3
# Decide whether a message needs a search ("hello" doesn't), and write the
# standalone search queries for it (services/query/prompts/planner.md).
# Costs one short model call.
CHAT_PLAN=true
# Most messages get one query. A message asking about several distinct things,
# or asking for a comparison, may get up to this many -- they share
# CHAT_AUTO_SOURCE_TOKENS and each one costs its own search and rerank pass,
# so raising it buys breadth with latency.
CHAT_MAX_QUERIES=2
# The automatic search passes every relevant passage (RAG_RERANK_MIN_SCORE),
# best first, until this many approximate tokens: a narrow question gets one
# or two, a broad one many.
CHAT_AUTO_SOURCE_TOKENS=3500
# Safety caps on passages from the automatic search and per tool search.
CHAT_INITIAL_SOURCES=10
CHAT_TOOL_RESULTS=6
# Extra tool searches per answer (0 = automatic search only).
CHAT_MAX_TOOL_ROUNDS=2
# Budgets, in approximate tokens: all passages in one answer, and how much
# earlier conversation is sent along (oldest turns are dropped first).
CHAT_MAX_SOURCE_TOKENS=6000
CHAT_HISTORY_MAX_TOKENS=8000

# ---- Accounts ----
# How callers are identified. "password": email + password, and a signed
# session cookie (accounts are created with `ragctl user add`; there is no
# self-registration). "proxy": trust an authenticating reverse proxy's header
# instead -- tailscale serve, oauth2-proxy -- which is only safe when the
# service can ONLY be reached through that proxy.
QUERY_AUTH_MODE=password
# In proxy mode, the headers carrying the signed-in user's email and name.
QUERY_PROXY_USER_HEADER=X-Forwarded-Email
QUERY_PROXY_NAME_HEADER=X-Forwarded-User
# Key the session cookie is signed with. Left empty, one is generated once and
# kept in data/session.key; deleting that file signs everyone out.
QUERY_SESSION_SECRET=
# Send the session cookie over https only. Turn this on once the service is
# behind TLS, and leave it off while testing on plain http.
QUERY_HTTPS_ONLY=false

# ---- Concurrent sessions ----
# The GPU is the bottleneck, not the web server: the reranker is one model
# behind a lock and Ollama holds one set of weights, so answering ten
# questions at once only makes all ten slow. Turns beyond these limits wait
# in line and the client is told its position (a "queued" event).
QUERY_MAX_CONCURRENT=2
# Turns one user may have running at once, so one person can't fill the
# machine while others wait. The line itself is fair between users: a freed
# slot goes to whoever has the least running or waiting already.
QUERY_MAX_PER_USER=2
# Refuse outright once this many turns are already waiting (in total, or from
# one user), and give up on a turn that has waited this long (seconds) rather
# than hanging forever.
QUERY_MAX_QUEUED=32
QUERY_MAX_QUEUED_PER_USER=4
QUERY_QUEUE_WAIT=180

# ---- Ingest limits (per user, per rolling window) ----
# Converting a document is the most expensive thing here -- a 580-page scan
# is minutes of OCR on the same GPU that answers questions -- so uploads
# through the API are capped. Admins are exempt (filling the library is their
# job), and files put in data/inbox by hand aren't counted either.
INGEST_MAX_FILE_MB=200
INGEST_MAX_FILES_PER_WINDOW=20
INGEST_MAX_MB_PER_WINDOW=500
INGEST_QUOTA_WINDOW_HOURS=24

# ---- OCR / ingestion ----
# Language(s) ocrmac (Apple Vision) recognizes in scanned pages, as Apple
# locale codes, space separated, e.g. "en-US" or "en-US de-DE". Born-digital
# PDFs aren't OCR'd at all -- ingest detects them per page and uses their
# embedded text, so there is no "force OCR" setting.
OCR_LANG=en-US
# Below this many characters per page, a converted document is treated as
# low quality and re-run through the VLM fallback pipeline.
MIN_CHARS_PER_PAGE=200
# Rebuild PDF heading levels (docling marks every heading level 1) from
# bookmarks, numbering or measured heading styles, so chunks carry their full
# heading path. A few seconds per book, no model calls.
INGEST_HEADING_LEVELS=true
# Run the batch ingest pipeline automatically when files land in data/inbox
# (via a LaunchAgent watching the folder). false = you run `ragctl ingest` yourself.
INGEST_AUTORUN=false

# ---- Logs ----
# Everything the services print lands in data/logs (launchd writes them
# there). A LaunchAgent checks their size hourly and rotates any file past
# LOG_MAX_MB, keeping LOG_KEEP compressed generations (query-api.log.1.gz,
# .2.gz, ...). Rotation is copy-and-truncate, so running services keep
# writing to the same file without a restart. LOG_KEEP=0 just empties the
# file instead of archiving it. Rotate by hand with `ragctl logs rotate`.
LOG_MAX_MB=20
LOG_KEEP=5
# Seconds between size checks. Raise it on a quiet machine; lower it if a
# service can produce more than LOG_MAX_MB within an hour.
LOG_ROTATE_INTERVAL=3600

# ---- Resource sizing ----
# Raise these on a bigger machine (e.g. Mac Studio). Defaults here are
# conservative for a 24GB laptop running everything at once.
OLLAMA_MAX_LOADED_MODELS=4
OLLAMA_NUM_PARALLEL=4
OLLAMA_CONTEXT_LENGTH=32768
# How many requests Ollama will hold in its queue before rejecting new ones
# with a 503 "server busy". Embedding a large document's chunks arrives as
# a burst, which can exceed Ollama's own default (512). Raised for headroom.
OLLAMA_MAX_QUEUE=1024
DOCLING_NUM_THREADS=4
# Pinned to 1: >1 runs two docling conversions as two threads in one
# process, which drives torch's MPS backend concurrently and segfaults the
# server (unguarded caches in MetalShaderLibrary + command-encoder state
# touched off the serial queue). Killed a whole 19-file batch on 2026-09-21.
# Upstream: pytorch/pytorch#197805, fixes open in #197836 + #197837 — raise
# this again only once those have landed in the installed torch.
DOCLING_LOC_NUM_WORKERS=1
