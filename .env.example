########################################################################
# rag-stack configuration
#
# Copy this file to .env and fill in the MODEL_* values. Everything
# else has a sane default for a single-machine deployment. Run
# `./ragctl install` after editing this file.
########################################################################

# ---- Models (you provide these; pull them with `ollama pull <name>`) ----
# Run `./ragctl models check` after `ollama pull` to confirm names match.

# Everyday chat model — fast, used for most questions.
CHAT_MODEL_EVERYDAY=

# Hard-questions chat model — larger, used when the user picks it explicitly.
CHAT_MODEL_HARD=

# Embedding model, served by Ollama (e.g. bge-m3, qwen3-embedding).
EMBED_MODEL=

# Vision-language model used ONLY as an OCR fallback for pages that
# come out garbled from OCRmyPDF + Docling (e.g. a Qwen-VL model).
VLM_MODEL=

# ---- Networking ----
# Bind address for Open WebUI. Keep 127.0.0.1 for a single-user laptop.
# Set to 0.0.0.0 to serve other machines on the network (e.g. on the
# Mac Studio, once it's the shared team box).
BIND_ADDR=127.0.0.1
WEBUI_PORT=3000
QDRANT_PORT=6333
DOCLING_PORT=5001
OLLAMA_PORT=11434

# ---- Open WebUI ----
WEBUI_NAME=RAG Stack
# Generated automatically by `ragctl install` if left blank.
WEBUI_SECRET_KEY=
# Set to false once the admin account exists, so nobody else can self-register.
ENABLE_SIGNUP=true
# Filled in by you after creating the admin account in the browser:
# Admin Panel -> Settings -> Account -> API keys (or Admin -> Users -> your
# user -> Settings -> Account). Required for `ragctl webui-setup` and
# `ragctl ingest` (both call the Open WebUI API).
OWUI_API_KEY=
# Name of the knowledge base that chat uploads and batch ingestion share.
KB_NAME=Knowledge Base

# ---- Retrieval tuning ----
RAG_TOP_K=20
RAG_TOP_K_RERANKER=6
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- OCR / ingestion ----
# BCP-47 / tesseract language code(s), space separated, e.g. "eng" or "eng+deu".
OCR_LANG=eng
# Below this many characters per page, a converted document is treated as
# low quality and re-run through the VLM fallback pipeline.
MIN_CHARS_PER_PAGE=200
# Run the batch ingest pipeline automatically when files land in data/inbox
# (via a LaunchAgent watching the folder). false = you run `ragctl ingest` yourself.
INGEST_AUTORUN=false

# ---- Resource sizing ----
# Raise these on a bigger machine (e.g. Mac Studio). Defaults here are
# conservative for a 24GB laptop running everything at once.
OLLAMA_MAX_LOADED_MODELS=4
OLLAMA_NUM_PARALLEL=4
OLLAMA_CONTEXT_LENGTH=32768
DOCLING_NUM_THREADS=4
DOCLING_LOC_NUM_WORKERS=2

# ---- Preflight ----
# ragctl install refuses to proceed below this much free disk space (GB).
MIN_FREE_GB=41
