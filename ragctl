#!/bin/bash
# ragctl — single entry point for the rag-stack deployment.
#
# Manages: Ollama.app tuning (native), docling-serve (native), Qdrant
# (Docker), and the batch ingestion pipeline. Everything it installs
# lives inside this repo, in Docker volumes prefixed "ragstack_", or in
# LaunchAgents labelled "com.ragstack.*".
#
# Run `./ragctl help` for the command list.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$REPO_ROOT/.env"
ENV_EXAMPLE="$REPO_ROOT/.env.example"
DATA_DIR="$REPO_ROOT/data"
RUNTIME_DIR="$REPO_ROOT/.runtime"
LAUNCHD_RENDERED="$RUNTIME_DIR/launchd"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
LOG_DIR="$DATA_DIR/logs"

# ---------------------------------------------------------------- colors --
c_red() { printf '\033[31m%s\033[0m\n' "$*"; }
c_green() { printf '\033[32m%s\033[0m\n' "$*"; }
c_yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
ok() { c_green "✓ $*"; }
warn() { c_yellow "! $*"; }
err() { c_red "✗ $*" >&2; }
die() { err "$*"; exit 1; }

# ------------------------------------------------------------------ env --
load_env() {
    [[ -f "$ENV_FILE" ]] || die ".env not found. Run: cp .env.example .env, edit it, then re-run."
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
    OLLAMA_PORT="${OLLAMA_PORT:-11434}"
    DOCLING_PORT="${DOCLING_PORT:-5001}"
    QDRANT_PORT="${QDRANT_PORT:-6333}"
    QUERY_PORT="${QUERY_PORT:-8088}"
    MIN_FREE_GB="${MIN_FREE_GB:-41}"
}

compose() {
    docker compose --env-file "$ENV_FILE" -f "$REPO_ROOT/compose.yaml" "$@"
}

# The Docker services ragctl starts. Listed explicitly so that anything else
# in compose.yaml (e.g. the retired open-webui service) is never pulled or started.
COMPOSE_SERVICES=(qdrant)

# ------------------------------------------------------------- preflight --
check_free_disk_gb() {
    df -g "$REPO_ROOT" | awk 'NR==2 {print $4}'
}

cmd_preflight() {
    local fail=0

    [[ "$(uname -s)" == "Darwin" ]] || { err "This stack targets macOS."; fail=1; }
    [[ "$(uname -m)" == "arm64" ]] || warn "Not running on arm64 — MLX/Metal acceleration assumptions won't hold."

    local free_gb
    free_gb="$(check_free_disk_gb)"
    if (( free_gb < MIN_FREE_GB )); then
        err "Only ${free_gb}GB free on disk; need at least ${MIN_FREE_GB}GB (see README for the breakdown)."
        err "Free up $((MIN_FREE_GB - free_gb))GB more, then re-run. ragctl will not delete anything for you."
        fail=1
    else
        ok "Disk space: ${free_gb}GB free (need ${MIN_FREE_GB}GB)"
    fi

    if ! command -v brew >/dev/null; then
        err "Homebrew is required: https://brew.sh"
        fail=1
    else
        ok "Homebrew found"
    fi

    if ! command -v uv >/dev/null && [[ ! -x "$HOME/.local/bin/uv" ]]; then
        warn "uv not found yet — will be installed via Brewfile"
    fi

    if ! docker info >/dev/null 2>&1; then
        err "Docker is not running. Start Docker Desktop (or install it: https://www.docker.com/products/docker-desktop/), then re-run."
        fail=1
    else
        local mem_bytes
        mem_bytes="$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)"
        local mem_gb=$(( mem_bytes / 1073741824 ))
        if (( mem_gb > 0 && mem_gb < 6 )); then
            warn "Docker Desktop has only ${mem_gb}GB of RAM allocated. Recommend >=8GB in Docker Desktop -> Settings -> Resources."
        fi
        ok "Docker is running"
    fi

    if ! curl -sf "http://127.0.0.1:${OLLAMA_PORT}/api/version" >/dev/null 2>&1; then
        err "Ollama is not reachable on 127.0.0.1:${OLLAMA_PORT}. Install/start Ollama.app: https://ollama.com/download"
        fail=1
    else
        ok "Ollama is reachable"
    fi

    for p in "$DOCLING_PORT" "$QDRANT_PORT" "$QUERY_PORT"; do
        if lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then
            warn "Port $p is already in use — check it's not a leftover ragstack process (ragctl status)."
        fi
    done

    return "$fail"
}

# --------------------------------------------------------------- render --
resolve_uv_bin() {
    # launchd runs our scripts with a bare PATH, so bake in an absolute
    # path to uv rather than relying on it being found at runtime.
    if command -v uv >/dev/null 2>&1; then
        command -v uv
    elif [[ -x /opt/homebrew/bin/uv ]]; then
        echo /opt/homebrew/bin/uv
    elif [[ -x /usr/local/bin/uv ]]; then
        echo /usr/local/bin/uv
    elif [[ -x "$HOME/.local/bin/uv" ]]; then
        echo "$HOME/.local/bin/uv"
    else
        die "uv not found. Run 'brew bundle --file=$REPO_ROOT/Brewfile' (or 'ragctl install') first."
    fi
}

render_template() {
    local src="$1" dst="$2"
    mkdir -p "$(dirname "$dst")"
    sed \
        -e "s#__REPO_ROOT__#${REPO_ROOT}#g" \
        -e "s#__UV_BIN__#$(resolve_uv_bin)#g" \
        -e "s#__OLLAMA_PORT__#${OLLAMA_PORT}#g" \
        -e "s#__DOCLING_PORT__#${DOCLING_PORT}#g" \
        -e "s#__QUERY_PORT__#${QUERY_PORT}#g" \
        -e "s#__OLLAMA_CONTEXT_LENGTH__#${OLLAMA_CONTEXT_LENGTH:-32768}#g" \
        -e "s#__OLLAMA_NUM_PARALLEL__#${OLLAMA_NUM_PARALLEL:-4}#g" \
        -e "s#__OLLAMA_MAX_LOADED_MODELS__#${OLLAMA_MAX_LOADED_MODELS:-4}#g" \
        -e "s#__OLLAMA_MAX_QUEUE__#${OLLAMA_MAX_QUEUE:-1024}#g" \
        -e "s#__DOCLING_NUM_THREADS__#${DOCLING_NUM_THREADS:-4}#g" \
        -e "s#__DOCLING_LOC_NUM_WORKERS__#${DOCLING_LOC_NUM_WORKERS:-2}#g" \
        "$src" > "$dst"
}

render_all() {
    mkdir -p "$LAUNCHD_RENDERED" "$LOG_DIR"
    render_template "$REPO_ROOT/launchd/ollama-env.sh.tmpl" "$LAUNCHD_RENDERED/ollama-env.sh"
    render_template "$REPO_ROOT/launchd/docling-serve.sh.tmpl" "$LAUNCHD_RENDERED/docling-serve.sh"
    render_template "$REPO_ROOT/launchd/ingest-watch.sh.tmpl" "$LAUNCHD_RENDERED/ingest-watch.sh"
    render_template "$REPO_ROOT/launchd/query-api.sh.tmpl" "$LAUNCHD_RENDERED/query-api.sh"
    chmod +x "$LAUNCHD_RENDERED"/*.sh

    render_template "$REPO_ROOT/launchd/com.ragstack.ollama-env.plist.tmpl" "$LAUNCHD_RENDERED/com.ragstack.ollama-env.plist"
    render_template "$REPO_ROOT/launchd/com.ragstack.docling.plist.tmpl" "$LAUNCHD_RENDERED/com.ragstack.docling.plist"
    render_template "$REPO_ROOT/launchd/com.ragstack.ingest.plist.tmpl" "$LAUNCHD_RENDERED/com.ragstack.ingest.plist"
    render_template "$REPO_ROOT/launchd/com.ragstack.query.plist.tmpl" "$LAUNCHD_RENDERED/com.ragstack.query.plist"
}

launchd_label_loaded() {
    launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1
}

load_agent() {
    local plist_name="$1"
    local src="$LAUNCHD_RENDERED/$plist_name.plist"
    local dst="$LAUNCH_AGENTS_DIR/$plist_name.plist"
    mkdir -p "$LAUNCH_AGENTS_DIR"
    cp "$src" "$dst"
    if launchd_label_loaded "$plist_name"; then
        launchctl bootout "gui/$(id -u)/$plist_name" >/dev/null 2>&1 || true
        # bootout returns before launchd finishes tearing the job down
        # (releasing its port, etc). An immediate bootstrap can race and
        # fail with "Bootstrap failed: 5: Input/output error" -- wait for
        # the label to actually disappear (or give up after ~2s) before
        # retrying.
        for _ in $(seq 1 20); do
            launchd_label_loaded "$plist_name" || break
            sleep 0.1
        done
    fi
    local attempt
    for attempt in 1 2 3; do
        launchctl bootstrap "gui/$(id -u)" "$dst" 2>&1 && return 0
        sleep 0.5
    done
    die "Failed to load LaunchAgent $plist_name after $attempt attempts."
}

unload_agent() {
    local plist_name="$1"
    launchctl bootout "gui/$(id -u)/$plist_name" >/dev/null 2>&1 || true
    rm -f "$LAUNCH_AGENTS_DIR/$plist_name.plist"
}

# --------------------------------------------------------------- install --
cmd_install() {
    if [[ ! -f "$ENV_FILE" ]]; then
        cp "$ENV_EXAMPLE" "$ENV_FILE"
        warn "Created .env from .env.example. Fill in CHAT_MODEL_EVERYDAY, CHAT_MODEL_HARD, EMBED_MODEL, VLM_MODEL, then re-run 'ragctl install'."
        exit 1
    fi
    load_env

    echo "== Preflight =="
    cmd_preflight || die "Preflight failed. Fix the items above and re-run."

    for m in CHAT_MODEL_EVERYDAY EMBED_MODEL; do
        [[ -n "${!m:-}" ]] || die "$m is empty in .env. Set it (and run 'ollama pull <name>') before installing."
    done

    mkdir -p "$DATA_DIR"/{inbox,work,processed,failed,logs,docling-artifacts,hf-cache}

    echo "== System dependencies (brew bundle) =="
    brew bundle --file="$REPO_ROOT/Brewfile"

    echo "== Python environments (uv sync) =="
    (cd "$REPO_ROOT/services/docling" && uv sync --python 3.12)
    (cd "$REPO_ROOT/services/ingest" && uv sync --python 3.12)
    (cd "$REPO_ROOT/services/embed" && uv sync --python 3.12)
    (cd "$REPO_ROOT/services/query" && uv sync --python 3.12)

    echo "== LaunchAgents =="
    render_all
    load_agent "com.ragstack.ollama-env"
    load_agent "com.ragstack.docling"
    if [[ "${INGEST_AUTORUN:-false}" == "true" ]]; then
        load_agent "com.ragstack.ingest"
        ok "Ingest auto-run enabled (watching data/inbox)"
    else
        unload_agent "com.ragstack.ingest"
    fi
    ok "LaunchAgents installed and loaded"

    echo "== Prefetching docling models (best-effort) =="
    (cd "$REPO_ROOT/services/docling" && HF_HOME="$DATA_DIR/hf-cache" uv run --python 3.12 docling-tools models download -o "$DATA_DIR/docling-artifacts") \
        || warn "Model prefetch skipped/failed — docling-serve will download models into data/docling-artifacts on first use instead."

    echo "== Prefetching the reranker model (best-effort) =="
    (cd "$REPO_ROOT/services/query" && uv run --python 3.12 rerank.py --download) \
        || warn "Reranker prefetch failed — it will download into data/hf-cache on the first 'ragctl search' instead."

    echo "== Docker services =="
    compose pull "${COMPOSE_SERVICES[@]}"
    compose up -d "${COMPOSE_SERVICES[@]}"

    echo "== Query service =="
    load_agent "com.ragstack.query"
    ok "Query service loaded (http://127.0.0.1:${QUERY_PORT})"

    echo
    ok "Install complete."
    cat <<EOF

Next steps:
  1. Run: ./ragctl health
  2. Drop files in data/inbox and run: ./ragctl ingest && ./ragctl embed
  3. Chat API: http://127.0.0.1:${QUERY_PORT}/api (OpenAI-compatible: /v1, docs: /docs)
EOF
}

# ------------------------------------------------------------- up/down --
cmd_up() {
    load_env
    render_all
    load_agent "com.ragstack.ollama-env"
    load_agent "com.ragstack.docling"
    if [[ "${INGEST_AUTORUN:-false}" == "true" ]]; then
        load_agent "com.ragstack.ingest"
    fi
    compose up -d "${COMPOSE_SERVICES[@]}"
    load_agent "com.ragstack.query"
    ok "Stack is up. Query API: http://127.0.0.1:${QUERY_PORT}"
}

cmd_down() {
    load_env
    compose down
    unload_agent "com.ragstack.query"
    unload_agent "com.ragstack.docling"
    unload_agent "com.ragstack.ingest"
    ok "Docker services stopped; docling-serve and the query service unloaded. Ollama.app is left running (it's a shared, native app)."
}

cmd_restart() {
    cmd_down
    cmd_up
}

cmd_reload() {
    # Re-render configs from .env and restart the native services + containers
    # so changed settings actually take effect.
    load_env
    render_all
    load_agent "com.ragstack.ollama-env"
    load_agent "com.ragstack.docling"
    if [[ "${INGEST_AUTORUN:-false}" == "true" ]]; then
        load_agent "com.ragstack.ingest"
    else
        unload_agent "com.ragstack.ingest"
    fi
    compose up -d --force-recreate "${COMPOSE_SERVICES[@]}"
    load_agent "com.ragstack.query"
    ok "Reloaded."
}

# -------------------------------------------------------------- status --
cmd_status() {
    load_env
    echo "== Native services =="
    for label in com.ragstack.ollama-env com.ragstack.docling com.ragstack.ingest com.ragstack.query; do
        if launchd_label_loaded "$label"; then ok "$label loaded"; else info "$label not loaded"; fi
    done
    if pgrep -x "Ollama" >/dev/null 2>&1; then ok "Ollama.app running"; else warn "Ollama.app not running"; fi

    echo "== Docker services =="
    compose ps

    echo "== Reachability =="
    for pair in "Ollama:http://127.0.0.1:${OLLAMA_PORT}/api/version" \
                "docling-serve:http://127.0.0.1:${DOCLING_PORT}/health" \
                "Qdrant:http://127.0.0.1:${QDRANT_PORT}/readyz" \
                "query API:http://127.0.0.1:${QUERY_PORT}/api/health"; do
        name="${pair%%:*}"; url="${pair#*:}"
        if curl -sf "$url" >/dev/null 2>&1; then ok "$name reachable ($url)"; else warn "$name NOT reachable ($url)"; fi
    done
}

cmd_logs() {
    load_env
    local svc="${1:-}"
    case "$svc" in
        docling) tail -n 100 -f "$LOG_DIR/docling-serve.log" ;;
        ollama) tail -n 100 -f "$LOG_DIR/ollama-env.log" ;;
        ingest) tail -n 100 -f "$LOG_DIR/ingest-watch.log" ;;
        query) tail -n 100 -f "$LOG_DIR/query-api.log" ;;
        qdrant) compose logs -f "$svc" ;;
        "") compose logs -f ;;
        *) die "Unknown service '$svc'. Try: docling, ollama, ingest, query, qdrant" ;;
    esac
}

# ------------------------------------------------------------- models --
cmd_models_check() {
    load_env
    local missing=0
    local installed
    installed="$(curl -sf "http://127.0.0.1:${OLLAMA_PORT}/api/tags" | python3 -c 'import json,sys; print("\n".join(m["name"] for m in json.load(sys.stdin).get("models",[])))' 2>/dev/null || true)"
    for m in CHAT_MODEL_EVERYDAY CHAT_MODEL_HARD EMBED_MODEL VLM_MODEL; do
        local name="${!m:-}"
        if [[ -z "$name" ]]; then
            warn "$m is not set in .env"
            continue
        fi
        # Ollama normalizes an untagged name to "<name>:latest" in 'ollama list',
        # so a bare "bge-m3" in .env must also match "bge-m3:latest".
        local name_latest="$name"
        [[ "$name" == *:* ]] || name_latest="${name}:latest"
        if grep -qxF "$name" <<<"$installed" || grep -qxF "$name_latest" <<<"$installed"; then
            ok "$m -> $name (installed)"
        else
            err "$m -> $name (NOT found in 'ollama list'; run: ollama pull $name)"
            missing=1
        fi
    done
    return "$missing"
}

# ----------------------------------------------------------------- ingest --
cmd_ingest() {
    load_env
    (cd "$REPO_ROOT/services/ingest" && uv run --python 3.12 ingest.py "$@")
}

# ------------------------------------------------------------------ embed --
cmd_embed() {
    load_env
    (cd "$REPO_ROOT/services/embed" && uv run --python 3.12 embed.py "$@")
}

# ------------------------------------------------------------------- user --
cmd_user() {
    load_env
    (cd "$REPO_ROOT/services/query" && uv run --python 3.12 usercli.py "$@")
}

# ----------------------------------------------------------------- search --
cmd_search() {
    load_env
    [[ -n "${1:-}" ]] || die "Usage: ragctl search \"question\" [--fused] [--json] [-v]"
    (cd "$REPO_ROOT/services/query" && uv run --python 3.12 retrieval.py "$@")
}

# ----------------------------------------------------------------- health --
cmd_health() {
    load_env
    local fail=0
    echo "== Ollama =="
    if curl -sf "http://127.0.0.1:${OLLAMA_PORT}/api/version" >/dev/null; then ok "reachable"; else err "unreachable"; fail=1; fi
    cmd_models_check || fail=1
    if [[ -n "${EMBED_MODEL:-}" ]]; then
        if curl -sf "http://127.0.0.1:${OLLAMA_PORT}/api/embed" -d "{\"model\":\"${EMBED_MODEL}\",\"input\":\"health check\"}" | grep -q "embedding"; then
            ok "embedding model responds"
        else
            err "embedding model did not return a vector"; fail=1
        fi
    fi

    echo "== docling-serve =="
    curl -sf "http://127.0.0.1:${DOCLING_PORT}/health" >/dev/null && ok "reachable" || { err "unreachable"; fail=1; }

    echo "== Qdrant =="
    curl -sf "http://127.0.0.1:${QDRANT_PORT}/readyz" >/dev/null && ok "reachable" || { err "unreachable"; fail=1; }

    echo "== Query service =="
    local qh
    if qh="$(curl -s --max-time 10 "http://127.0.0.1:${QUERY_PORT}/api/health")" && [[ -n "$qh" ]]; then
        # Its own checks: Ollama, the Qdrant collection, the database, the reranker device.
        if python3 -c 'import json,sys; d=json.loads(sys.argv[1]); [print(("  ok  " if v["ok"] else "  FAIL ") + k + ": " + ", ".join(f"{a}={b}" for a, b in v.items() if a != "ok")) for k, v in d.items() if isinstance(v, dict)]; sys.exit(0 if d["ok"] else 1)' "$qh"; then
            ok "healthy"
        else
            err "reports problems (above)"; fail=1
        fi
    else
        err "unreachable on port ${QUERY_PORT} (ragctl logs query)"; fail=1
    fi

    if (( fail )); then err "Health check found problems."; else ok "All checks passed."; fi
    return "$fail"
}

# ------------------------------------------------------------------ clean --
cmd_clean() {
    load_env
    if [[ "${1:-}" != "--yes" ]]; then
        die "This deletes data/{inbox,work,processed,failed,markdown,docling,manifest.jsonl}, the Qdrant collection, all chat history and all accounts (users, groups, grants). Re-run as: ragctl clean --yes"
    fi

    echo "== Local ingest data =="
    rm -rf "$DATA_DIR/inbox" "$DATA_DIR/work" "$DATA_DIR/processed" "$DATA_DIR/failed" \
        "$DATA_DIR/markdown" "$DATA_DIR/docling" "$DATA_DIR/manifest.jsonl"
    mkdir -p "$DATA_DIR"/{inbox,work,processed,failed}
    ok "Cleared data/inbox, work, processed, failed, markdown, docling and manifest.jsonl"

    echo "== Qdrant =="
    local collection="${QDRANT_COLLECTION:-ragstack_chunks}"
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' -X DELETE "http://127.0.0.1:${QDRANT_PORT}/collections/${collection}" || true)"
    case "$code" in
        200) ok "Deleted collection ${collection}" ;;
        404) info "Collection ${collection} did not exist" ;;
        *) warn "Could not reach Qdrant to delete collection ${collection} (HTTP ${code:-none}). Start it with 'ragctl up' and re-run clean, or 'ragctl embed --recreate' will rebuild it." ;;
    esac

    echo "== Chat history =="
    if [[ -f "$DATA_DIR/chat.db" ]]; then
        # Delete rows rather than the file: a running query service keeps
        # using it, and would otherwise recreate it without its tables.
        # Everything goes, including accounts -- this is a full reset. The
        # next login has to be `ragctl user add ... --admin` again.
        sqlite3 "$DATA_DIR/chat.db" \
            "PRAGMA foreign_keys=ON; DELETE FROM conversations; DELETE FROM uploads; DELETE FROM grants; DELETE FROM group_members; DELETE FROM groups; DELETE FROM libraries; DELETE FROM users;" \
            && ok "Deleted all conversations, uploads, users, groups and grants" \
            || warn "Could not clear data/chat.db"
    else
        info "No chat history yet"
    fi

    echo
    ok "Clean complete."
    warn "Model caches (data/hf-cache, data/docling-artifacts) were left in place on purpose — they're not your data, and re-downloading them is wasteful. Delete them by hand if you really want to."
}

# -------------------------------------------------------------- uninstall --
cmd_uninstall() {
    load_env
    local purge=0
    [[ "${1:-}" == "--purge-data" ]] && purge=1

    compose down -v 2>/dev/null || true
    unload_agent "com.ragstack.ollama-env"
    unload_agent "com.ragstack.docling"
    unload_agent "com.ragstack.ingest"
    unload_agent "com.ragstack.query"
    rm -rf "$RUNTIME_DIR"
    for svc in docling ingest embed query; do rm -rf "$REPO_ROOT/services/$svc/.venv"; done

    if (( purge )); then
        rm -rf "$DATA_DIR"
        ok "Removed Docker volumes, LaunchAgents, local Python envs and data/."
    else
        ok "Removed Docker volumes, LaunchAgents and local Python envs. data/ was left in place — pass --purge-data to remove it too."
    fi
    warn "Ollama.app itself was left installed and running; this stack only tuned its env vars via launchctl setenv (cleared on next reboot, or unset manually)."
}

# -------------------------------------------------------------------- cli --
usage() {
    cat <<EOF
ragctl — control the rag-stack deployment

Usage: ./ragctl <command> [args]

  install              Preflight checks, install deps, start everything
  up                    Start native services (incl. the query API) + Docker containers
  down                  Stop Docker containers + docling-serve (Ollama.app left running)
  restart               down then up
  reload                Re-render configs from .env and restart everything
  status                Show what's running and reachable
  logs [svc]             Tail logs (svc: docling, ollama, ingest, query, qdrant)
  models check           Verify .env model names exist in 'ollama list'
  ingest [--force-vlm] [--reprocess]
                         Convert data/inbox to markdown + docling JSON once
                         (--reprocess re-converts data/processed in place)
  embed [--recreate] [--show-chunks [--doc SHA] [--full]]
                         Chunk, embed and index converted docs into Qdrant
                         (--show-chunks prints the chunking without embedding)
  user <add|list|passwd|disable|admin|delete|group|member|grant|revoke|permissions>
                         Accounts, groups and permissions. Create the first
                         admin with: ragctl user add you@example.com --admin
  search "question" [--fused] [--json] [-v]
                         Hybrid search + GPU reranking over the index
                         (settings: RAG_* and RERANKER_* in .env)
  health                 End-to-end connectivity check
  clean --yes             Wipe ingest data, outputs, the Qdrant collection and chat history
  uninstall [--purge-data]  Tear down containers, agents and local envs
EOF
}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        install) cmd_install "$@" ;;
        up) cmd_up "$@" ;;
        down) cmd_down "$@" ;;
        restart) cmd_restart "$@" ;;
        reload) cmd_reload "$@" ;;
        status) cmd_status "$@" ;;
        logs) cmd_logs "$@" ;;
        models)
            case "${1:-}" in check) cmd_models_check ;; *) die "Usage: ragctl models check" ;; esac ;;
        ingest) cmd_ingest "$@" ;;
        embed) cmd_embed "$@" ;;
        user) cmd_user "$@" ;;
        search) cmd_search "$@" ;;
        health) cmd_health "$@" ;;
        clean) cmd_clean "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        help|-h|--help) usage ;;
        *) err "Unknown command: $cmd"; usage; exit 1 ;;
    esac
}

main "$@"
