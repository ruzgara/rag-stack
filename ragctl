# --------------------------------------------------------------------- ui --
# The web UI (ui/, Svelte + Vite + TS). ui/dist is committed to git, so
# installing and running the stack never needs Node or pnpm -- only
# changing the UI does. Unlike resolve_uv_bin, nothing here ever runs under
# launchd, so there is no bare-PATH problem to work around: this always runs
# in a contributor's own interactive shell, where nvm/fnm/volta has already
# put the right pnpm on PATH. A hardcoded fallback path list would risk
# picking the wrong one.
UI_DIR="$REPO_ROOT/ui"

resolve_pnpm_bin() {
    command -v pnpm 2>/dev/null \
        || die "pnpm not found. ui/dist is committed, so you only need Node/pnpm to *change* the UI. Install pnpm (https://pnpm.io/installation, or 'brew install pnpm') and re-run."
}

cmd_ui() {
    local action="${1:-build}"; shift || true
    [[ -d "$UI_DIR" ]] || die "ui/ not found at $UI_DIR"
    local pnpm; pnpm="$(resolve_pnpm_bin)"

    case "$action" in
        install)
            echo "== UI dependencies =="
            (cd "$UI_DIR" && "$pnpm" install --frozen-lockfile)
            ok "Installed ui/node_modules"
            ;;
        dev)
            load_env
            echo "== UI dev server =="
            info "Proxies /api, /v1 and /admin to http://127.0.0.1:${QUERY_PORT} -- keep './ragctl up' running alongside this."
            info "Sign in again at http://localhost:5173 -- it is a different cookie host from 127.0.0.1, so a 127.0.0.1 session doesn't carry over."
            [[ -d "$UI_DIR/node_modules" ]] || (cd "$UI_DIR" && "$pnpm" install --frozen-lockfile)
            (cd "$UI_DIR" && "$pnpm" run dev -- "$@")
            ;;
        build)
            echo "== UI build =="
            [[ -d "$UI_DIR/node_modules" ]] || (cd "$UI_DIR" && "$pnpm" install --frozen-lockfile)
            (cd "$UI_DIR" && "$pnpm" run build)
            ok "Built ui/dist."
            warn "ui/dist is committed -- 'git add ui/dist' and commit, or the running service keeps serving the old build."
            ;;
        check)
            [[ -d "$UI_DIR/node_modules" ]] || (cd "$UI_DIR" && "$pnpm" install --frozen-lockfile)
            (cd "$UI_DIR" && "$pnpm" run check)
            ;;
        test)
            [[ -d "$UI_DIR/node_modules" ]] || (cd "$UI_DIR" && "$pnpm" install --frozen-lockfile)
            (cd "$UI_DIR" && "$pnpm" run test -- --run "$@")
            ;;
        *)
            die "Usage: ragctl ui <install|dev|build|check|test>"
            ;;
    esac
}

# ----------------------------------------------------------------- health --
cmd_health() {
    load_env
    local fail=0
    echo "== Ollama =="
    if curl -sf "http://127.0.0.1:${OLLAMA_PORT}/api/version" >/dev/null; then ok "reachable"; else err "unreachable"; fail=1; fi
    cmd_models_check || fail=1
    if [[ -n "${EMBED_MODEL:-}" ]]; then
        if curl -sf "http://127.0.0.1:${OLLAMA_PORT}/api/embed" -d "{\"model\":\"${EMBED_MODEL}\",\"input\":\"health check\"}" | grep -q "embedding"; then
            ok "embedding model responds"
        else
            err "embedding model did not return a vector"; fail=1
        fi
    fi

    echo "== docling-serve =="
    curl -sf "http://127.0.0.1:${DOCLING_PORT}/health" >/dev/null && ok "reachable" || { err "unreachable"; fail=1; }

    echo "== Qdrant =="
    curl -sf "http://127.0.0.1:${QDRANT_PORT}/readyz" >/dev/null && ok "reachable" || { err "unreachable"; fail=1; }

    echo "== Query service =="
    local qh
    if qh="$(curl -s --max-time 10 "http://127.0.0.1:${QUERY_PORT}/api/health")" && [[ -n "$qh" ]]; then
        # Its own checks: Ollama, the Qdrant collection, the database, the reranker device.
        if python3 -c 'import json,sys; d=json.loads(sys.argv[1]); [print(("  ok  " if v["ok"] else "  FAIL ") + k + ": " + ", ".join(f"{a}={b}" for a, b in v.items() if a != "ok")) for k, v in d.items() if isinstance(v, dict)]; sys.exit(0 if d["ok"] else 1)' "$qh"; then
            ok "healthy"
        else
            err "reports problems (above)"; fail=1
        fi
    else
        err "unreachable on port ${QUERY_PORT} (ragctl logs query)"; fail=1
    fi

    if (( fail )); then err "Health check found problems."; else ok "All checks passed."; fi
    return "$fail"
}

# ------------------------------------------------------------------ clean --
cmd_clean() {
    load_env
    if [[ "${1:-}" != "--yes" ]]; then
        die "This deletes data/{inbox,work,processed,failed,markdown,docling,manifest.jsonl}, the Qdrant collection, all chat history and all accounts (users, groups, libraries, access). Re-run as: ragctl clean --yes"
    fi

    echo "== Local ingest data =="
    rm -rf "$DATA_DIR/inbox" "$DATA_DIR/work" "$DATA_DIR/processed" "$DATA_DIR/failed" \
        "$DATA_DIR/markdown" "$DATA_DIR/docling" "$DATA_DIR/manifest.jsonl"
    mkdir -p "$DATA_DIR"/{inbox,work,processed,failed}
    ok "Cleared data/inbox, work, processed, failed, markdown, docling and manifest.jsonl"

    echo "== Qdrant =="
    local collection="${QDRANT_COLLECTION:-ragstack_chunks}"
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' -X DELETE "http://127.0.0.1:${QDRANT_PORT}/collections/${collection}" || true)"
    case "$code" in
        200) ok "Deleted collection ${collection}" ;;
        404) info "Collection ${collection} did not exist" ;;
        *) warn "Could not reach Qdrant to delete collection ${collection} (HTTP ${code:-none}). Start it with 'ragctl up' and re-run clean, or 'ragctl embed --recreate' will rebuild it." ;;
    esac

    echo "== Chat history =="
    if [[ -f "$DATA_DIR/chat.db" ]]; then
        # Delete the file, not just its rows: there are no migrations
        # (see services/query/db.py), so only a fresh file picks up the
        # current schema -- a row-cleared one keeps its old tables and the
        # service fails to start once the schema has moved on. Everything
        # goes, including accounts; the next login needs `ragctl user add
        # ... --admin` again.
        #
        # The query service opens the file per request, so a running one
        # would recreate it empty, without tables. It's stopped first and
        # started again after, and its startup builds the schema.
        local query_was_running=false
        if launchd_label_loaded "com.ragstack.query"; then
            query_was_running=true
            launchctl bootout "gui/$(id -u)/com.ragstack.query" >/dev/null 2>&1 || true
            for _ in $(seq 1 30); do
                launchd_label_loaded "com.ragstack.query" || break
                sleep 0.1
            done
        fi
        rm -f "$DATA_DIR/chat.db" "$DATA_DIR/chat.db-wal" "$DATA_DIR/chat.db-shm"
        ok "Deleted data/chat.db: all conversations, uploads, users, groups, libraries and access"
        if $query_was_running; then
            render_all
            load_agent "com.ragstack.query"
            ok "Restarted the query service; it recreated data/chat.db with the current schema"
        fi
    else
        info "No chat history yet"
    fi

    echo
    ok "Clean complete."
    warn "Model caches (data/hf-cache, data/docling-artifacts) were left in place on purpose — they're not your data, and re-downloading them is wasteful. Delete them by hand if you really want to."
}

# -------------------------------------------------------------- uninstall --
cmd_uninstall() {
    load_env
    local purge=0
    [[ "${1:-}" == "--purge-data" ]] && purge=1

    compose down -v 2>/dev/null || true
    unload_agent "com.ragstack.ollama-env"
    unload_agent "com.ragstack.docling"
    unload_agent "com.ragstack.ingest"
    unload_agent "com.ragstack.query"
    unload_agent "com.ragstack.logrotate"
    rm -rf "$RUNTIME_DIR"
    for svc in docling ingest embed query; do rm -rf "$REPO_ROOT/services/$svc/.venv"; done
    rm -rf "$REPO_ROOT/ui/node_modules" "$REPO_ROOT/ui/.vite" # ui/dist itself is committed -- left in place

    if (( purge )); then
        rm -rf "$DATA_DIR"
        ok "Removed Docker volumes, LaunchAgents, local Python envs and data/."
    else
        ok "Removed Docker volumes, LaunchAgents and local Python envs. data/ was left in place — pass --purge-data to remove it too."
    fi
    warn "Ollama.app itself was left installed and running; this stack only tuned its env vars via launchctl setenv (cleared on next reboot, or unset manually)."
}

# -------------------------------------------------------------------- cli --
usage() {
    cat <<EOF
ragctl — control the rag-stack deployment

Usage: ./ragctl <command> [args]

  install              Preflight checks, install deps, start everything
  up                    Start native services (incl. the query API) + Docker containers
  down                  Stop Docker containers + docling-serve (Ollama.app left running)
  restart               down then up
  reload [--skip-query] Re-render configs from .env and restart everything
                         (--skip-query leaves the query API running; it is how
                          the admin UI reloads the stack from inside it)
  status                Show what's running and reachable
  logs [svc]             Tail logs (svc: docling, ollama, ingest, query, qdrant)
  logs rotate [--force]  Rotate data/logs now (size-based; LOG_MAX_MB / LOG_KEEP
                         in .env). Runs hourly on its own via a LaunchAgent.
  models check           Verify .env model names exist in 'ollama list' (or on OpenRouter)
  ingest [--force-vlm] [--reprocess]
                         Convert data/inbox to markdown + docling JSON once
                         (--reprocess re-converts data/processed in place)
  embed [--recreate] [--show-chunks [--doc SHA] [--full]]
                         Chunk, embed and index converted docs into Qdrant
                         (--show-chunks prints the chunking without embedding)
  user <add|list|passwd|disable|admin|delete|group|member|library>
                         Accounts, groups and libraries (ownership + sharing).
                         Create the first admin with: ragctl user add you@example.com --admin
  search "question" [--fused] [--json] [-v]
                         Hybrid search + GPU reranking over the index
                         (settings: RAG_* and RERANKER_* in .env)
  ui <install|dev|build|check|test>
                         The web UI (ui/, Svelte + Vite). dist/ is committed,
                         so installing and running the stack never needs
                         Node — only changing the UI does.
  health                 End-to-end connectivity check
  clean --yes             Wipe ingest data, outputs, the Qdrant collection and chat history
  uninstall [--purge-data]  Tear down containers, agents and local envs
EOF
}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        install) cmd_install "$@" ;;
        up) cmd_up "$@" ;;
        down) cmd_down "$@" ;;
        restart) cmd_restart "$@" ;;
        reload) cmd_reload "$@" ;;
        status) cmd_status "$@" ;;
        logs) cmd_logs "$@" ;;
        models)
            case "${1:-}" in check) cmd_models_check ;; *) die "Usage: ragctl models check" ;; esac ;;
        ingest) cmd_ingest "$@" ;;
        embed) cmd_embed "$@" ;;
        user) cmd_user "$@" ;;
        search) cmd_search "$@" ;;
        ui) cmd_ui "$@" ;;
        health) cmd_health "$@" ;;
        clean) cmd_clean "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        help|-h|--help) usage ;;
        *) err "Unknown command: $cmd"; usage; exit 1 ;;
    esac
}

main "$@"
