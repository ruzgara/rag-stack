<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ragstack.ingest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/.runtime/launchd/ingest-watch.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>__REPO_ROOT__/data/inbox</string>
    </array>
    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/data/logs/ingest-watch.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/data/logs/ingest-watch.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
