<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ragstack.docling</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_ROOT__/.runtime/launchd/docling-serve.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/data/logs/docling-serve.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/data/logs/docling-serve.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
