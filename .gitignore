# Runtime data — never committed, never touched by uninstall unless --purge-data
data/
.runtime/
services/*/.venv/

# Secrets / local overrides
.env

# macOS
.DS_Store

# uv / python
__pycache__/
*.pyc

# Contributor-only UI toolchain. ui/dist is NOT ignored — it is what the
# query service serves, so it is committed and installing never needs Node.
ui/node_modules/
ui/.vite/
